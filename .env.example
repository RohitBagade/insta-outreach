# Copy to .env in the repository root (never commit it): the CLI loads it automatically.
# Variables already set in your shell / service manager take precedence.
INSTA_OUTREACH_CONFIG=config/settings.yaml

# Claude (message personalization + constrained browser fallback). Optional:
# without it, deterministic templates are used and unknown pages stop the lane.
ANTHROPIC_API_KEY=

# Meta Instagram Platform API (Tier 1). Leave empty until the app is set up.
IG_ACCESS_TOKEN=
IG_USER_ID=
IG_APP_SECRET=
IG_WEBHOOK_VERIFY_TOKEN=

# Control plane bearer token. Required in the live environment (control endpoints answer 503 without it).
CONTROL_API_TOKEN=

# Optional: incidents & warm-lead handoffs are POSTed here (n8n / Slack relay / ...).
NOTIFY_WEBHOOK_URL=

# Optional: phone alerts through a Telegram bot (docs/DEPLOY.md §6).
# Create the bot with @BotFather, press Start in it, then `insta-outreach alerts find-chat`.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Optional: where you open Mission Control (e.g. your Tailscale https://….ts.net address); linked in alerts.
DASHBOARD_URL=

# Any setting can be overridden: INSTA__SECTION__KEY=value, e.g.
# INSTA__LIMITS__OUTREACH_PER_DAY=10
